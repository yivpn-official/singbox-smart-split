{
  "final": "proxy",
  "auto_detect_interface": true,
  "default_domain_resolver": "dns-direct",
  "rules": [
    {
      "action": "sniff"
    },
    {
      "protocol": "dns",
      "action": "hijack-dns"
    },
    {
      "ip_is_private": true,
      "outbound": "direct"
    },
    {
      "domain_suffix": [
        ".local",
        ".lan",
        ".internal",
        ".home.arpa"
      ],
      "outbound": "direct"
    },
    {
      "rule_set": [
        "geoip-local"
      ],
      "outbound": "direct"
    }
  ]
}
